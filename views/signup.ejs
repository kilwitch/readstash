<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('./partials/head') %>
</head>
<body>
  <div class="bg-glow-wrapper">
    <div class="bg-glow-1"></div>
    <div class="bg-glow-2"></div>
  </div>

  <%- include('./partials/nav') %>

  <main class="auth-page-wrapper">
    <div class="auth-card">
      <div class="auth-header">
        <div class="brand-icon mx-auto mb-3" style="width: 48px; height: 48px; font-size: 1.4rem;">
          <i class="bi bi-bookmark-star"></i>
        </div>
        <h2>Start Your Bookshelf</h2>
        <p>Save, manage, and revisit your favorite books anytime</p>
      </div>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert-custom alert-danger-custom">
          <i class="bi bi-exclamation-triangle-fill"></i>
          <div><%= error %></div>
        </div>
      <% } %>

      <form action="/user/signup" method="POST">
        <div class="mb-3">
          <label for="fullNameInput" class="form-label-custom">Full Name</label>
          <div class="input-group">
            <span class="input-group-text bg-transparent border-secondary text-secondary" style="border-color: var(--border-color) !important;">
              <i class="bi bi-person"></i>
            </span>
            <input 
              type="text" 
              name="fullName" 
              id="fullNameInput" 
              class="form-control-custom" 
              placeholder="e.g. Maya Angelou" 
              value="<%= typeof fullName !== 'undefined' ? fullName : '' %>"
              required 
              autofocus
            >
          </div>
        </div>

        <div class="mb-3">
          <label for="emailInput" class="form-label-custom">Email Address</label>
          <div class="input-group">
            <span class="input-group-text bg-transparent border-secondary text-secondary" style="border-color: var(--border-color) !important;">
              <i class="bi bi-envelope"></i>
            </span>
            <input 
              type="email" 
              name="email" 
              id="emailInput" 
              class="form-control-custom" 
              placeholder="name@example.com" 
              value="<%= typeof email !== 'undefined' ? email : '' %>"
              required
            >
          </div>
        </div>

        <div class="mb-3">
          <label for="passwordInput" class="form-label-custom">Password</label>
          <div class="input-group">
            <span class="input-group-text bg-transparent border-secondary text-secondary" style="border-color: var(--border-color) !important;">
              <i class="bi bi-shield-lock"></i>
            </span>
            <input 
              type="password" 
              name="password" 
              id="passwordInput" 
              class="form-control-custom" 
              placeholder="At least 6 characters" 
              required
            >
          </div>
        </div>

        <div class="mb-4">
          <label for="confirmPasswordInput" class="form-label-custom">Confirm Password</label>
          <div class="input-group">
            <span class="input-group-text bg-transparent border-secondary text-secondary" style="border-color: var(--border-color) !important;">
              <i class="bi bi-shield-check"></i>
            </span>
            <input 
              type="password" 
              name="confirmPassword" 
              id="confirmPasswordInput" 
              class="form-control-custom" 
              placeholder="Repeat password" 
              required
            >
          </div>
        </div>

        <button type="submit" class="btn-primary-glow w-100 justify-content-center py-2 mb-3">
          <i class="bi bi-sparkles"></i> Create Free Account
        </button>
      </form>

      <div class="text-center mt-3 pt-3 border-top" style="border-color: var(--border-color) !important;">
        <span class="text-muted small">Already have an account?</span>
        <a href="/user/signin" class="ms-1 fw-semibold">Sign in here</a>
      </div>
    </div>
  </main>

  <footer class="app-footer">
    <div class="container">
      <p class="mb-0">ReadStash &copy; 2026. Your personal digital sanctuary for books and ideas.</p>
    </div>
  </footer>

  <%- include('./partials/script') %>
</body>
</html>