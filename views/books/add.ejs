<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <div class="bg-glow-wrapper">
    <div class="bg-glow-1"></div>
    <div class="bg-glow-2"></div>
  </div>

  <%- include('../partials/nav') %>

  <main class="container py-4 my-2">
    <div class="row justify-content-center">
      <div class="col-lg-8 col-md-10">
        <!-- Back Navigation -->
        <div class="mb-3">
          <a href="/" class="text-secondary d-inline-flex align-items-center gap-2 small">
            <i class="bi bi-arrow-left"></i> Back to Bookshelf
          </a>
        </div>

        <div class="auth-card" style="max-width: 100%;">
          <div class="d-flex align-items-center justify-content-between mb-4 border-bottom pb-3" style="border-color: var(--border-color) !important;">
            <div>
              <h2 class="mb-1 font-serif text-white">Add Book to Stash</h2>
              <p class="text-secondary small mb-0">Record a new title in your digital library</p>
            </div>
            <div class="brand-icon" style="width: 44px; height: 44px; font-size: 1.25rem;">
              <i class="bi bi-bookmark-plus"></i>
            </div>
          </div>

          <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert-custom alert-danger-custom">
              <i class="bi bi-exclamation-triangle-fill"></i>
              <div><%= error %></div>
            </div>
          <% } %>

          <form action="/books/add" method="POST" enctype="multipart/form-data">
            <div class="row g-3">
              <!-- Title -->
              <div class="col-md-7">
                <label for="bookTitle" class="form-label-custom">Book Title *</label>
                <input 
                  type="text" 
                  name="title" 
                  id="bookTitle" 
                  class="form-control-custom" 
                  placeholder="e.g. Atomic Habits, Dune, Deep Work" 
                  value="<%= typeof book !== 'undefined' && book.title ? book.title : '' %>"
                  required 
                  autofocus
                >
              </div>

              <!-- Author -->
              <div class="col-md-5">
                <label for="bookAuthor" class="form-label-custom">Author *</label>
                <input 
                  type="text" 
                  name="author" 
                  id="bookAuthor" 
                  class="form-control-custom" 
                  placeholder="e.g. James Clear" 
                  value="<%= typeof book !== 'undefined' && book.author ? book.author : '' %>"
                  required
                >
              </div>

              <!-- Genre & Status -->
              <div class="col-md-6">
                <label for="bookGenre" class="form-label-custom">Genre / Category</label>
                <input 
                  type="text" 
                  name="genre" 
                  id="bookGenre" 
                  class="form-control-custom" 
                  placeholder="e.g. Productivity, Sci-Fi, Philosophy" 
                  value="<%= typeof book !== 'undefined' && book.genre ? book.genre : '' %>"
                >
              </div>

              <div class="col-md-6">
                <label for="bookStatus" class="form-label-custom">Reading Status</label>
                <select name="status" id="bookStatus" class="form-select-custom">
                  <option value="wantToRead" <%= typeof book !== 'undefined' && book.status === 'wantToRead' ? 'selected' : '' %>>📌 Want to Read</option>
                  <option value="reading" <%= typeof book !== 'undefined' && book.status === 'reading' ? 'selected' : '' %>>📖 Currently Reading</option>
                  <option value="read" <%= typeof book !== 'undefined' && book.status === 'read' ? 'selected' : '' %>>✅ Finished / Read</option>
                </select>
              </div>

              <!-- Rating (Stars) -->
              <div class="col-md-6">
                <label class="form-label-custom mb-1">Your Rating</label>
                <div class="d-flex align-items-center gap-3 pt-1">
                  <div class="star-rating-input">
                    <input type="radio" id="star5" name="rating" value="5" <%= typeof book !== 'undefined' && book.rating == 5 ? 'checked' : '' %>><label for="star5" title="5 stars"><i class="bi bi-star-fill"></i></label>
                    <input type="radio" id="star4" name="rating" value="4" <%= typeof book !== 'undefined' && book.rating == 4 ? 'checked' : '' %>><label for="star4" title="4 stars"><i class="bi bi-star-fill"></i></label>
                    <input type="radio" id="star3" name="rating" value="3" <%= typeof book !== 'undefined' && book.rating == 3 ? 'checked' : '' %>><label for="star3" title="3 stars"><i class="bi bi-star-fill"></i></label>
                    <input type="radio" id="star2" name="rating" value="2" <%= typeof book !== 'undefined' && book.rating == 2 ? 'checked' : '' %>><label for="star2" title="2 stars"><i class="bi bi-star-fill"></i></label>
                    <input type="radio" id="star1" name="rating" value="1" <%= typeof book !== 'undefined' && book.rating == 1 ? 'checked' : '' %>><label for="star1" title="1 star"><i class="bi bi-star-fill"></i></label>
                  </div>
                  <span class="text-muted small">(Click to rate)</span>
                </div>
              </div>

              <!-- Page Tracking -->
              <div class="col-md-6">
                <div class="row g-2">
                  <div class="col-6">
                    <label for="currentPage" class="form-label-custom">Current Page</label>
                    <input 
                      type="number" 
                      name="currentPage" 
                      id="currentPage" 
                      class="form-control-custom" 
                      min="0" 
                      placeholder="e.g. 120"
                      value="<%= typeof book !== 'undefined' && book.currentPage ? book.currentPage : '' %>"
                    >
                  </div>
                  <div class="col-6">
                    <label for="totalPages" class="form-label-custom">Total Pages</label>
                    <input 
                      type="number" 
                      name="totalPages" 
                      id="totalPages" 
                      class="form-control-custom" 
                      min="0" 
                      placeholder="e.g. 320"
                      value="<%= typeof book !== 'undefined' && book.totalPages ? book.totalPages : '' %>"
                    >
                  </div>
                </div>
              </div>

              <!-- Favorite Quote -->
              <div class="col-12">
                <label for="favoriteQuote" class="form-label-custom">Favorite Quote / Memorable Line</label>
                <input 
                  type="text" 
                  name="favoriteQuote" 
                  id="favoriteQuote" 
                  class="form-control-custom" 
                  placeholder="&quot;You do not rise to the level of your goals. You fall to the level of your systems.&quot;"
                  value="<%= typeof book !== 'undefined' && book.favoriteQuote ? book.favoriteQuote : '' %>"
                >
              </div>

              <!-- Personal Notes -->
              <div class="col-12">
                <label for="bookNotes" class="form-label-custom">Personal Notes & Key Takeaways</label>
                <textarea 
                  name="notes" 
                  id="bookNotes" 
                  rows="4" 
                  class="form-control-custom" 
                  placeholder="What made this book special? Summary, key ideas, thoughts..."
                ><%= typeof book !== 'undefined' && book.notes ? book.notes : '' %></textarea>
              </div>

              <!-- Cover Image Upload & URL Fallback -->
              <div class="col-md-7">
                <label for="coverImage" class="form-label-custom">Book Cover File Upload</label>
                <input 
                  type="file" 
                  name="coverImage" 
                  id="coverImage" 
                  class="form-control-custom" 
                  accept="image/*"
                >
                <div class="form-text text-muted small mt-1">Upload JPG, PNG, WEBP, or SVG cover image.</div>
              </div>

              <div class="col-md-5">
                <label for="customCoverURL" class="form-label-custom">Or Cover Image URL</label>
                <input 
                  type="url" 
                  name="customCoverURL" 
                  id="customCoverURL" 
                  class="form-control-custom" 
                  placeholder="https://images.unsplash.com/..."
                >
              </div>

              <!-- Preview Thumbnail -->
              <div class="col-12 text-center pt-2">
                <img 
                  id="coverPreview" 
                  src="" 
                  alt="Cover Preview" 
                  style="display: none; max-height: 160px; border-radius: var(--radius-sm); border: 1px solid var(--border-light); margin: 0 auto;"
                >
              </div>
            </div>

            <!-- Submit Button -->
            <div class="d-flex align-items-center justify-content-end gap-3 mt-4 pt-3 border-top" style="border-color: var(--border-color) !important;">
              <a href="/" class="btn-secondary-glass" style="padding: 0.65rem 1.25rem;">Cancel</a>
              <button type="submit" class="btn-primary-glow" style="padding: 0.65rem 1.6rem;">
                <i class="bi bi-check-lg"></i> Save to Bookshelf
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </main>

  <footer class="app-footer">
    <div class="container">
      <p class="mb-0">ReadStash &copy; 2026. Your personal digital sanctuary for books and ideas.</p>
    </div>
  </footer>

  <%- include('../partials/script') %>
</body>
</html>
