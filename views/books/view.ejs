<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <div class="bg-glow-wrapper">
    <div class="bg-glow-1"></div>
    <div class="bg-glow-2"></div>
  </div>

  <%- include('../partials/nav') %>

  <main class="container book-detail-wrapper">
    <!-- Breadcrumb / Back Link -->
    <div class="d-flex align-items-center justify-content-between mb-4">
      <a href="/" class="text-secondary d-inline-flex align-items-center gap-2 small">
        <i class="bi bi-arrow-left"></i> Back to My Bookshelf
      </a>

      <!-- Actions -->
      <div class="d-flex align-items-center gap-2">
        <a href="/books/edit/<%= book._id %>" class="btn-secondary-glass" style="padding: 0.45rem 1rem; font-size: 0.9rem;">
          <i class="bi bi-pencil-square"></i> Edit
        </a>
        <button type="button" class="btn btn-outline-danger btn-sm px-3" data-bs-toggle="modal" data-bs-target="#deleteModal">
          <i class="bi bi-trash3"></i> Delete
        </button>
      </div>
    </div>

    <!-- Book Detail Card -->
    <div class="book-detail-card p-4 p-md-5">
      <div class="row g-4 g-lg-5 align-items-start">
        <!-- Book Cover Column -->
        <div class="col-md-5 col-lg-4 text-center">
          <img 
            src="<%= book.coverImageURL || '/images/book.png' %>" 
            alt="<%= book.title %>" 
            class="book-detail-cover"
            onerror="this.src='/images/book.png';"
          >

          <!-- Quick Status Switcher Form -->
          <div class="mt-4 p-3 rounded" style="background: rgba(0, 0, 0, 0.25); border: 1px solid var(--border-color);">
            <div class="small text-muted mb-2 text-start font-monospace text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.05em;">Update Reading Status</div>
            <form action="/books/status/<%= book._id %>" method="POST" class="d-flex gap-2">
              <select name="status" class="form-select-custom py-1 px-2" style="font-size: 0.85rem;" onchange="this.form.submit()">
                <option value="wantToRead" <%= book.status === 'wantToRead' ? 'selected' : '' %>>📌 Want to Read</option>
                <option value="reading" <%= book.status === 'reading' ? 'selected' : '' %>>📖 Currently Reading</option>
                <option value="read" <%= book.status === 'read' ? 'selected' : '' %>>✅ Finished / Read</option>
              </select>
            </form>
          </div>
        </div>

        <!-- Book Information Column -->
        <div class="col-md-7 col-lg-8">
          <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
            <span class="badge" style="background: rgba(245, 158, 11, 0.15); color: var(--accent-amber-light); border: 1px solid rgba(245, 158, 11, 0.3); font-size: 0.8rem; padding: 0.35rem 0.75rem;">
              <%= book.genre || 'General' %>
            </span>

            <% if (book.status === 'reading') { %>
              <span class="badge badge-reading py-2 px-3">
                <i class="bi bi-book-half"></i> Currently Reading
              </span>
            <% } else if (book.status === 'wantToRead') { %>
              <span class="badge badge-wantToRead py-2 px-3">
                <i class="bi bi-bookmark-fill"></i> Want to Read
              </span>
            <% } else if (book.status === 'read') { %>
              <span class="badge badge-read py-2 px-3">
                <i class="bi bi-check2-circle"></i> Finished
              </span>
            <% } %>
          </div>

          <h1 class="text-white display-6 fw-bold mb-2 font-serif"><%= book.title %></h1>
          <h4 class="text-secondary fw-normal mb-3">by <span class="text-light fw-medium"><%= book.author %></span></h4>

          <!-- Star Rating -->
          <div class="d-flex align-items-center gap-3 mb-4">
            <div class="star-rating-display" style="font-size: 1.25rem;">
              <% for(let i = 1; i <= 5; i++) { %>
                <i class="bi <%= i <= (book.rating || 0) ? 'bi-star-fill' : 'bi-star star-empty' %>"></i>
              <% } %>
            </div>
            <span class="text-secondary small">
              <%= book.rating > 0 ? `${book.rating} out of 5 stars` : 'Not yet rated' %>
            </span>
          </div>

          <!-- Reading Progress (If pages provided) -->
          <% if (book.totalPages > 0) { 
               const percent = Math.min(100, Math.round(((book.currentPage || 0) / book.totalPages) * 100));
          %>
            <div class="p-3 rounded mb-4" style="background: rgba(255, 255, 255, 0.03); border: 1px solid var(--border-color);">
              <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="small text-secondary fw-semibold">Reading Progress</span>
                <span class="small fw-bold text-white"><%= book.currentPage || 0 %> / <%= book.totalPages %> pages (<%= percent %>%)</span>
              </div>
              <div class="progress-track">
                <div class="progress-fill" style="width: <%= percent %>%;"></div>
              </div>
            </div>
          <% } %>

          <!-- Favorite Quote -->
          <% if (book.favoriteQuote) { %>
            <div class="quote-callout">
              <i class="bi bi-quote fs-4 text-warning opacity-75"></i>
              <p class="mb-0 mt-1"><%= book.favoriteQuote %></p>
            </div>
          <% } %>

          <!-- Personal Notes Section -->
          <div class="mt-4 pt-2">
            <h5 class="text-white font-serif mb-3 d-flex align-items-center gap-2">
              <i class="bi bi-journal-text text-warning"></i> Personal Notes & Takeaways
            </h5>
            <% if (book.notes && book.notes.trim()) { %>
              <div class="p-4 rounded" style="background: rgba(0, 0, 0, 0.28); border: 1px solid var(--border-color); color: #d1d5db; white-space: pre-line; line-height: 1.7; font-size: 0.975rem;">
                <%= book.notes %>
              </div>
            <% } else { %>
              <div class="p-4 rounded text-center text-muted" style="background: rgba(0, 0, 0, 0.2); border: 1px dashed var(--border-color);">
                <i class="bi bi-card-text fs-3 mb-2 d-block"></i>
                No personal notes added yet. <a href="/books/edit/<%= book._id %>">Add thoughts or highlights</a>.
              </div>
            <% } %>
          </div>

          <!-- Meta Info -->
          <div class="mt-4 pt-3 border-top d-flex flex-wrap gap-4 text-muted small" style="border-color: var(--border-color) !important;">
            <div><i class="bi bi-calendar3 me-1"></i> Added on <%= new Date(book.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %></div>
            <div><i class="bi bi-clock-history me-1"></i> Last updated <%= new Date(book.updatedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %></div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <!-- Delete Confirmation Modal -->
  <div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content" style="background: var(--bg-card); border: 1px solid var(--border-color); color: #fff;">
        <div class="modal-header border-bottom" style="border-color: var(--border-color) !important;">
          <h5 class="modal-title font-serif" id="deleteModalLabel">Remove from Bookshelf</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body text-secondary">
          Are you sure you want to remove <strong class="text-white">"<%= book.title %>"</strong>? This will permanently delete your notes, quotes, and progress for this book.
        </div>
        <div class="modal-footer border-top" style="border-color: var(--border-color) !important;">
          <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
          <form action="/books/delete/<%= book._id %>" method="POST" class="d-inline">
            <button type="submit" class="btn btn-danger btn-sm">
              <i class="bi bi-trash3"></i> Yes, Remove Book
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>

  <footer class="app-footer">
    <div class="container">
      <p class="mb-0">ReadStash &copy; 2026. Your personal digital sanctuary for books and ideas.</p>
    </div>
  </footer>

  <%- include('../partials/script') %>
</body>
</html>
