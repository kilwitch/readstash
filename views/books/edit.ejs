<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <div class="bg-glow-wrapper">
    <div class="bg-glow-1"></div>
    <div class="bg-glow-2"></div>
  </div>

  <%- include('../partials/nav') %>

  <main class="container py-4 my-2">
    <div class="row justify-content-center">
      <div class="col-lg-8 col-md-10">
        <!-- Back Navigation -->
        <div class="mb-3">
          <a href="/books/<%= book._id %>" class="text-secondary d-inline-flex align-items-center gap-2 small">
            <i class="bi bi-arrow-left"></i> Back to "<%= book.title %>"
          </a>
        </div>

        <div class="auth-card" style="max-width: 100%;">
          <div class="d-flex align-items-center justify-content-between mb-4 border-bottom pb-3" style="border-color: var(--border-color) !important;">
            <div>
              <h2 class="mb-1 font-serif text-white">Edit Book Details</h2>
              <p class="text-secondary small mb-0">Update information, notes, or reading progress</p>
            </div>
            <div class="brand-icon" style="width: 44px; height: 44px; font-size: 1.25rem;">
              <i class="bi bi-pencil"></i>
            </div>
          </div>

          <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert-custom alert-danger-custom">
              <i class="bi bi-exclamation-triangle-fill"></i>
              <div><%= error %></div>
            </div>
          <% } %>

          <form action="/books/edit/<%= book._id %>" method="POST" enctype="multipart/form-data">
            <div class="row g-3">
              <!-- Title -->
              <div class="col-md-7">
                <label for="bookTitle" class="form-label-custom">Book Title *</label>
                <input 
                  type="text" 
                  name="title" 
                  id="bookTitle" 
                  class="form-control-custom" 
                  value="<%= book.title %>" 
                  required
                >
              </div>

              <!-- Author -->
              <div class="col-md-5">
                <label for="bookAuthor" class="form-label-custom">Author *</label>
                <input 
                  type="text" 
                  name="author" 
                  id="bookAuthor" 
                  class="form-control-custom" 
                  value="<%= book.author %>" 
                  required
                >
              </div>

              <!-- Genre & Status -->
              <div class="col-md-6">
                <label for="bookGenre" class="form-label-custom">Genre / Category</label>
                <input 
                  type="text" 
                  name="genre" 
                  id="bookGenre" 
                  class="form-control-custom" 
                  value="<%= book.genre || '' %>"
                >
              </div>

              <div class="col-md-6">
                <label for="bookStatus" class="form-label-custom">Reading Status</label>
                <select name="status" id="bookStatus" class="form-select-custom">
                  <option value="wantToRead" <%= book.status === 'wantToRead' ? 'selected' : '' %>>📌 Want to Read</option>
                  <option value="reading" <%= book.status === 'reading' ? 'selected' : '' %>>📖 Currently Reading</option>
                  <option value="read" <%= book.status === 'read' ? 'selected' : '' %>>✅ Finished / Read</option>
                </select>
              </div>

              <!-- Rating (Stars) -->
              <div class="col-md-6">
                <label class="form-label-custom mb-1">Your Rating</label>
                <div class="d-flex align-items-center gap-3 pt-1">
                  <div class="star-rating-input">
                    <input type="radio" id="star5" name="rating" value="5" <%= book.rating == 5 ? 'checked' : '' %>><label for="star5" title="5 stars"><i class="bi bi-star-fill"></i></label>
                    <input type="radio" id="star4" name="rating" value="4" <%= book.rating == 4 ? 'checked' : '' %>><label for="star4" title="4 stars"><i class="bi bi-star-fill"></i></label>
                    <input type="radio" id="star3" name="rating" value="3" <%= book.rating == 3 ? 'checked' : '' %>><label for="star3" title="3 stars"><i class="bi bi-star-fill"></i></label>
                    <input type="radio" id="star2" name="rating" value="2" <%= book.rating == 2 ? 'checked' : '' %>><label for="star2" title="2 stars"><i class="bi bi-star-fill"></i></label>
                    <input type="radio" id="star1" name="rating" value="1" <%= book.rating == 1 ? 'checked' : '' %>><label for="star1" title="1 star"><i class="bi bi-star-fill"></i></label>
                  </div>
                  <span class="text-muted small">(Click to rate)</span>
                </div>
              </div>

              <!-- Page Tracking -->
              <div class="col-md-6">
                <div class="row g-2">
                  <div class="col-6">
                    <label for="currentPage" class="form-label-custom">Current Page</label>
                    <input 
                      type="number" 
                      name="currentPage" 
                      id="currentPage" 
                      class="form-control-custom" 
                      min="0" 
                      value="<%= book.currentPage || 0 %>"
                    >
                  </div>
                  <div class="col-6">
                    <label for="totalPages" class="form-label-custom">Total Pages</label>
                    <input 
                      type="number" 
                      name="totalPages" 
                      id="totalPages" 
                      class="form-control-custom" 
                      min="0" 
                      value="<%= book.totalPages || 0 %>"
                    >
                  </div>
                </div>
              </div>

              <!-- Favorite Quote -->
              <div class="col-12">
                <label for="favoriteQuote" class="form-label-custom">Favorite Quote / Memorable Line</label>
                <input 
                  type="text" 
                  name="favoriteQuote" 
                  id="favoriteQuote" 
                  class="form-control-custom" 
                  value="<%= book.favoriteQuote || '' %>"
                >
              </div>

              <!-- Personal Notes -->
              <div class="col-12">
                <label for="bookNotes" class="form-label-custom">Personal Notes & Key Takeaways</label>
                <textarea 
                  name="notes" 
                  id="bookNotes" 
                  rows="5" 
                  class="form-control-custom"
                ><%= book.notes || '' %></textarea>
              </div>

              <!-- Existing Cover & Update Option -->
              <div class="col-md-3 text-center">
                <label class="form-label-custom">Current Cover</label>
                <img 
                  id="coverPreview" 
                  src="<%= book.coverImageURL || '/images/book.png' %>" 
                  alt="<%= book.title %>" 
                  style="max-height: 110px; width: 80px; object-fit: cover; border-radius: var(--radius-sm); border: 1px solid var(--border-light);"
                  onerror="this.src='/images/book.png';"
                >
              </div>

              <div class="col-md-5">
                <label for="coverImage" class="form-label-custom">Replace Cover File</label>
                <input 
                  type="file" 
                  name="coverImage" 
                  id="coverImage" 
                  class="form-control-custom" 
                  accept="image/*"
                >
              </div>

              <div class="col-md-4">
                <label for="customCoverURL" class="form-label-custom">Or Image URL</label>
                <input 
                  type="url" 
                  name="customCoverURL" 
                  id="customCoverURL" 
                  class="form-control-custom" 
                  placeholder="https://..."
                >
              </div>
            </div>

            <!-- Submit Buttons -->
            <div class="d-flex align-items-center justify-content-end gap-3 mt-4 pt-3 border-top" style="border-color: var(--border-color) !important;">
              <a href="/books/<%= book._id %>" class="btn-secondary-glass" style="padding: 0.65rem 1.25rem;">Cancel</a>
              <button type="submit" class="btn-primary-glow" style="padding: 0.65rem 1.6rem;">
                <i class="bi bi-save"></i> Save Changes
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </main>

  <footer class="app-footer">
    <div class="container">
      <p class="mb-0">ReadStash &copy; 2026. Your personal digital sanctuary for books and ideas.</p>
    </div>
  </footer>

  <%- include('../partials/script') %>
</body>
</html>
